#
# Useful if thesis source is ever added to the repository.
# ============================================================

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.loa
*.nav
*.snm
*.vrb


# ============================================================
