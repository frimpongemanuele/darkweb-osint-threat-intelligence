# ============================================================
# Security research artifacts
#
# These files can contain sensitive network, credential,
# endpoint, or investigation data and should not be committed
# accidentally.
# ============================================================

*.pcap
*.pcapng
*.cap

*.dmp
*.dump
*.mem
*.raw

*.har

captures/
dumps/


# ============================================================
# Virtualization
#
# Do not commit VM disks, snapshots, or runtime data.
# Sanitized configuration files may be committed manually
# when appropriate.
# ============================================================

*.vdi
*.vmdk
*.vhd
*.vhdx
*.ova
*.ovf

Snapshots/
VirtualBox VMs/

*.vbox-prev

VBox.log
VBox.log.*


# ============================================================
# Splunk / SIEM generated data
# ============================================================

splunk/var/
splunk/etc/auth/
splunk/etc/passwd

*.tsidx


# ============================================================
